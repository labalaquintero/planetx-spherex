# Variables opcionales de compose.yaml. Copia este archivo a .env (ignorado por Git) para cambiarlas.
# No pongas secretos aquí: este archivo se sube al repositorio.

# Dónde publica el web (nginx). WEB_BIND=0.0.0.0 lo abre a la red local.
WEB_BIND=127.0.0.1
WEB_PORT=80

# Caso preparado y PNG que lee la API, dentro del contenedor (./data se monta en /data, solo lectura).
PLANETX_CATALOG_MANIFEST=/data/wise0855/manifest.json
PLANETX_PRODUCTS_DIR=/data/wise0855/products

# Búsquedas en vivo simultáneas hacia IRSA (la búsqueda en vivo aún no está habilitada en la API).
PLANETX_LIVE_CONCURRENCY=2
